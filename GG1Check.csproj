<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpdQueueing</RootNamespace>
  </PropertyGroup>

  <!--
    This project builds GG1Check.cs only (the standalone G/G/1 assumption
    check). Program.cs and Mm1Check.cs live in the same folder but each has
    its own Main method, so both are excluded here. Directory.Build.props
    (UseArtifactsOutput) keeps this project's build output separate from
    the other two automatically.
  -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="Mm1Check.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

</Project>
